{
  "server": {
    "port": 8787,
    "bind": "lan",
    "shortcutBackend": "auto",
    "authToken": ""
  },
  "profiles": [
    {
      "id": "media",
      "name": "Media",
      "icon": "fa:music",
      "grid": { "rows": 4, "cols": 3 },
      "buttons": [
        { "id": 0, "label": "Previous", "icon": "fa:backward-step",
          "action": { "type": "shortcut", "keys": ["prev"] } },
        { "id": 1, "label": "Play/Pause", "icon": "fa:play", "color": "#6ee7ff",
          "action": { "type": "shortcut", "keys": ["play"] } },
        { "id": 2, "label": "Next", "icon": "fa:forward-step",
          "action": { "type": "shortcut", "keys": ["next"] } },
        { "id": 3, "label": "Vol −", "icon": "fa:volume-low",
          "action": { "type": "shortcut", "keys": ["voldown"] } },
        { "id": 4, "label": "Mute", "icon": "fa:volume-high",
          "action": { "type": "toggle",
            "on":  { "type": "shortcut", "keys": ["mute"] },
            "off": { "type": "shortcut", "keys": ["mute"] },
            "onState": { "color": "#ff5c7a", "glow": "solid", "icon": "fa:volume-xmark", "label": "Muted" } } },
        { "id": 5, "label": "Vol +", "icon": "fa:volume-high",
          "action": { "type": "shortcut", "keys": ["volup"] } },
        { "id": 6, "w": 2, "color": "#0f2a33", "content": "tap for the current track",
          "action": { "type": "script",
            "command": "playerctl metadata --format '{{ artist }} — {{ title }}' 2>/dev/null | jq -Rs 'rtrimstr(\"\\n\") | {content: (if . == \"\" then \"♪ nothing playing\" else . end)}'" } },
        { "id": 7, "label": "Shuffle", "icon": "fa:shuffle",
          "action": { "type": "script",
            "command": "playerctl shuffle Toggle 2>/dev/null; S=$(playerctl shuffle 2>/dev/null); if [ \"$S\" = \"On\" ]; then echo '{\"glow\":\"solid\",\"color\":\"#6ee7ff\"}'; else echo '{\"glow\":\"off\"}'; fi" } },
        { "id": 8, "color": "#0f2a33", "content": "📸 tap to shoot",
          "action": { "type": "script",
            "command": "grim ~/Pictures/screenshot-$(date +%s).png 2>/dev/null || import -window root ~/Pictures/screenshot-$(date +%s).png",
            "onSuccess": { "content": "📸 saved to ~/Pictures" },
            "onError": { "content": "✗ screenshot failed", "color": "#ff5c7a" } } },
        { "id": 9, "label": "Lock", "icon": "fa:lock",
          "action": { "type": "script", "command": "loginctl lock-session" } },
        { "id": 10, "label": "Caffeine", "icon": "fa:mug-hot",
          "action": { "type": "toggle",
            "on":  { "type": "script", "command": "systemd-inhibit --what=idle --why='macro pad caffeine' sleep 86400 >/dev/null 2>&1 &" },
            "off": { "type": "script", "command": "pkill -f '[s]ystemd-inhibit.*sleep 86400' || true" },
            "onState": { "glow": "breathing", "color": "#ffd180" } } }
      ]
    },
    {
      "id": "meet",
      "name": "Meetings",
      "icon": "fa:video",
      "match": { "apps": ["zoom", "teams", "webex"] },
      "grid": { "rows": 3, "cols": 3 },
      "buttons": [
        { "id": 0, "label": "Mic", "icon": "fa:microphone",
          "action": { "type": "toggle",
            "on":  { "type": "script", "command": "wpctl set-mute @DEFAULT_SOURCE@ 1" },
            "off": { "type": "script", "command": "wpctl set-mute @DEFAULT_SOURCE@ 0" },
            "onState": { "color": "#ff5c7a", "glow": "solid", "icon": "fa:microphone-slash", "label": "Muted" } } },
        { "id": 1, "label": "BRB", "icon": "fa:person-walking",
          "action": { "type": "text", "text": "be right back!" } },
        { "id": 2, "label": "Bye", "icon": "👋",
          "action": { "type": "text", "text": "Thanks everyone — bye!" } },
        { "id": 3, "w": 2, "color": "#3a0d16", "glow": "breathing",
          "content": "## ON AIR\n*speak slowly · mute often*", "contentType": "markdown" },
        { "id": 4, "label": "Reply", "icon": "fa:reply", "color": "#c084fc",
          "action": { "type": "prompt", "method": "paste", "placeholder": "Type a reply…" } },
        { "id": 5, "label": "Link", "icon": "fa:video",
          "action": { "type": "text", "text": "https://meet.example.com/team-standup", "method": "paste" } },
        { "id": 6, "label": "Thanks", "icon": "🙏",
          "action": { "type": "text", "text": "Thank you!" } },
        { "id": 7, "label": "Follow up", "icon": "fa:at",
          "action": { "type": "text", "text": "I'll follow up by email." } }
      ]
    },
    {
      "id": "dev",
      "name": "Dev",
      "icon": "fa:code",
      "match": { "apps": ["code", "cursor", "kitty", "alacritty"] },
      "grid": { "rows": 3, "cols": 3 },
      "buttons": [
        { "id": 0, "label": "Palette", "icon": "fa:bolt",
          "action": { "type": "shortcut", "keys": ["ctrl", "shift", "p"] } },
        { "id": 1, "label": "Quick open", "icon": "fa:file",
          "action": { "type": "shortcut", "keys": ["ctrl", "p"] } },
        { "id": 2, "label": "Format", "icon": "fa:indent",
          "action": { "type": "shortcut", "keys": ["shift", "alt", "f"] } },
        { "id": 3, "w": 2, "color": "#0d2818", "content": "tap for git status",
          "action": { "type": "script", "cwd": "/path/to/your/repo",
            "command": "git status -sb | head -1 | jq -Rs 'rtrimstr(\"\\n\") | {content: .}'" } },
        { "id": 4, "color": "#0d2818", "content": "npm test",
          "action": { "type": "script", "cwd": "/path/to/your/repo", "timeoutMs": 120000,
            "command": "npm test",
            "onSuccess": { "content": "✓ tests green", "color": "#00c853", "glow": "solid" },
            "onError": { "content": "✗ tests red", "color": "#ff5c7a", "glow": "solid" } } },
        { "id": 5, "label": "Commit msg", "icon": "fa:code-branch", "color": "#00c853",
          "action": { "type": "prompt", "placeholder": "feat: …" } },
        { "id": 6, "label": "Save all", "icon": "fa:floppy-disk",
          "action": { "type": "shortcut", "keys": ["ctrl", "k"], "then": [["s"]] } },
        { "id": 7, "color": "#0d2818", "content": "which branch?",
          "action": { "type": "script", "cwd": "/path/to/your/repo",
            "command": "git branch --show-current | jq -Rs 'rtrimstr(\"\\n\") | {content: (\"⎇ \" + .)}'" } }
      ]
    },
    {
      "id": "herdr",
      "name": "herdr",
      "icon": "fa:terminal",
      "grid": { "rows": 4, "cols": 4 },
      "buttons": [
        { "id": 0, "label": "New tab", "icon": "fa:plus", "color": "#c084fc",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["c"]] } },
        { "id": 1, "label": "Split →", "icon": "fa:table-columns",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["v"]] } },
        { "id": 2, "label": "Split ↓", "icon": "fa:grip-lines",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["minus"]] } },
        { "id": 3, "label": "Zoom", "icon": "fa:expand",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["z"]] } },
        { "id": 4, "label": "Pane ←", "icon": "fa:arrow-left",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["h"]] } },
        { "id": 5, "label": "Pane ↓", "icon": "fa:arrow-down",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["j"]] } },
        { "id": 6, "label": "Pane ↑", "icon": "fa:arrow-up",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["k"]] } },
        { "id": 7, "label": "Pane →", "icon": "fa:arrow-right",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["l"]] } },
        { "id": 8, "label": "Prev tab", "icon": "fa:chevron-left",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["p"]] } },
        { "id": 9, "label": "Next tab", "icon": "fa:chevron-right",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["n"]] } },
        { "id": 10, "label": "Sidebar", "icon": "fa:bars",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["b"]] } },
        { "id": 11, "label": "Detach", "icon": "fa:right-from-bracket",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["q"]] } },
        { "id": 12, "w": 2, "color": "#241533",
          "content": "## herdr cheatsheet\nprefix = **ctrl+b**, then:\n\n- **c** new tab · **n/p** prev/next\n- **v** / **-** split right/down\n- **h j k l** panes · **z** zoom\n- **w** workspaces · **g** go to\n- **q** detach (everything keeps running)",
          "contentType": "markdown" },
        { "id": 13, "label": "Type cmd", "icon": "fa:keyboard",
          "action": { "type": "prompt", "placeholder": "Type into the focused pane…" } },
        { "id": 14, "label": "Go to", "icon": "fa:magnifying-glass",
          "action": { "type": "shortcut", "keys": ["ctrl", "b"], "then": [["g"]] } }
      ]
    }
  ]
}
